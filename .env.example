# ---------------------------------------------------------------------------
# Operação Linha de Frente — variáveis de ambiente
# Copie para `.env.local`. Nunca versione arquivos .env.
# ---------------------------------------------------------------------------

# URL canônica pública. Usada em metadata, canonical, OG e sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- VSL -------------------------------------------------------------------
# MP4 progressivo ou playlist HLS servida por CDN (Mux, Bunny Stream, etc.).
NEXT_PUBLIC_VSL_SRC=
NEXT_PUBLIC_VSL_POSTER=

# --- Checkout --------------------------------------------------------------
# `pending` (padrão): o modal valida e informa que o pagamento não está ligado.
# `live`: o modal chama POST /api/checkout e redireciona para o Stripe.
NEXT_PUBLIC_CHECKOUT_MODE=pending

# --- Canal oficial ---------------------------------------------------------
# Sem valor, o CTA de WhatsApp do FAQ não é renderizado.
NEXT_PUBLIC_WHATSAPP_URL=

# ---------------------------------------------------------------------------
# BACKEND — ainda não implementado nesta fase. Mantido aqui como contrato.
# ---------------------------------------------------------------------------

# DATABASE_URL=

# Chaves de servidor. NUNCA prefixar com NEXT_PUBLIC_.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID=

# --- Analytics -------------------------------------------------------------
# NEXT_PUBLIC_GA_ID=
# NEXT_PUBLIC_META_PIXEL_ID=
